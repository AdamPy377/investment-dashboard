SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=adam
ADMIN_PASSWORD=replace-with-a-unique-password
VIEWER_USERNAME=brother
VIEWER_PASSWORD=replace-with-another-unique-password
HOST_PORT=3005
HOST_DATA_DIR=/home/adam/docker/investment-dashboard/data
HOST_BACKUP_DIR=/home/adam/docker/investment-dashboard/backups
BACKUP_RETENTION_DAYS=30
# Optional: EODHD supports US and ASX tickers; prices remain manual without a key.
EODHD_API_KEY=
REFRESH_SECONDS=3600
# Set to 1 only when accessed over HTTPS. Local HTTP needs 0.
COOKIE_SECURE=0
